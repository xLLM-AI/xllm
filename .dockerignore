# Keep the build context limited to image recipes, shared installers and vcpkg.
**
!vcpkg.json
!docker/
!docker/Dockerfile.*
!docker/requirements*.txt
!docker/install_*.sh
!docker/ascend/
!docker/ascend/**
!dist/
!dist/*.whl
!third_party/
!third_party/Mooncake/
!third_party/Mooncake/dependencies.sh
!third_party/Mooncake/extern/
!third_party/Mooncake/extern/yalantinglibs/
!third_party/Mooncake/extern/yalantinglibs/**
**/.git
