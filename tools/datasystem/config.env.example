# Copy to config.env and set MODEL_PATH before running NPU tests.
# Paths below belong to this clone, not to an earlier developer workspace.
export DS_PYTHON=python3.11
export DATASYSTEM_VERSION=0.8.1
# Public latest release checked on 2026-10-09 and selected for this repo.
# October SDK discovery and allocator fixes are integrated below.
export MODEL_PATH=
export MODEL_ID=qwen2.5_7B_Instruct
export MAX_JOBS=8
export ETCD_HOST=127.0.0.1
export ETCD_CLIENT_PORT=2379
export ETCD_PEER_PORT=2380
export DATASYSTEM_WORKER_HOST=127.0.0.1
export DATASYSTEM_WORKER_PORT=31501
export SERVICE_HTTP_PORT=28888
export SERVICE_RPC_PORT=28889
export PREFILL_DEVICE=0
export DECODE_DEVICE=1
export ASCEND_RT_VISIBLE_DEVICES=0,1
# An xllm-service binary built for this engine protocol is required for PD.
export XLLM_SERVICE_BIN=
export ETCD_BIN=etcd
export CANN_ENV_SH=/usr/local/Ascend/ascend-toolkit/set_env.sh
export ATB_ENV_SH=/usr/local/Ascend/nnal/atb/set_env.sh
